<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pysar.live</string>

  <!-- Streams each take to Gemini 3.5 Transcribe Live while the key is held.
       Standard library only, so the Parakeet venv's Python is enough; the keys
       are read on every take: ~/.pysar/gemini-key-free first, ~/.pysar/gemini-key
       when Google refuses it. -->
  <key>ProgramArguments</key>
  <array>
    <string>__VENV__/bin/python</string>
    <string>__REPO__/server/live_server.py</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>50063</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/.pysar/live.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.pysar/live.log</string>

  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
